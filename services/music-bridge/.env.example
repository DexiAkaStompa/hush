BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_SHARED_SECRET=replace-with-a-long-random-secret
BRIDGE_PUBLIC_URL=http://217.217.243.62:8787

# Lavalink v4 REST node. The password is public for the listed free nodes;
# use your own node credentials in production when possible.
LAVALINK_HOST=lavalink.jirayu.net
LAVALINK_PORT=443
LAVALINK_SECURE=true
LAVALINK_PASSWORD=youshallnotpass

# Supabase is used to authenticate Hush clients without exposing the bridge
# secret in the desktop bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Windows media tools. Keep yt-dlp.exe, ffmpeg.exe and ffprobe.exe in PATH,
# or provide absolute paths here.
YTDLP_PATH=yt-dlp.exe
FFMPEG_PATH=ffmpeg.exe
BRIDGE_TICKET_TTL_SECONDS=300
BRIDGE_SOURCE_HOSTS=youtube.com,youtu.be,spotify.com,soundcloud.com
BRIDGE_ALLOW_DIRECT_SOURCES=false

# Comma-separated origins allowed by the HTTP API.
BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:5173,hush://app,https://hush.app
