{
  "name": "hush-private-space",
  "productName": "Hush",
  "description": "Uno spazio privato per piccoli gruppi, con messaggi e media progettati per la cifratura end-to-end.",
  "author": {
    "name": "Hush contributors",
    "email": "hush@hush.app"
  },
  "homepage": "https://hush.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/DexiAkaStompa/hush.git"
  },
  "private": true,
  "version": "0.5.12",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k -n web,desktop -c cyan,magenta \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "icons:build": "node scripts/build-icons.mjs",
    "desktop:dir": "npm run icons:build && npm run build && electron-builder --dir",
    "desktop:build": "npm run icons:build && npm run build && electron-builder --win nsis",
    "desktop:deb": "npm run icons:build && npm run build && electron-builder --linux dir && node scripts/build-deb.mjs",
    "desktop:release": "npm run desktop:build && npm run desktop:deb",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.0",
    "@supabase/supabase-js": "latest",
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "uisfx": "^0.4.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "png-to-ico": "latest",
    "sharp": "latest",
    "tar": "^7.5.22",
    "typescript": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "app.hush.private",
    "productName": "Hush",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "DexiAkaStompa",
      "repo": "hush",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "docs/licenses/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Hush-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Network;Chat",
      "icon": "build/icon.png",
      "maintainer": "Hush contributors <hush@hush.app>",
      "artifactName": "Hush-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hush",
      "deleteAppDataOnUninstall": false
    }
  }
}
