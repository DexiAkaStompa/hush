{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the bundled main Hush window can control its native shell.",
  "windows": ["main"],
  "permissions": [
    "allow-native-version",
    "allow-native-pending-link",
    "allow-native-copy-text",
    "allow-native-set-material",
    "allow-native-search-music",
    "allow-native-show-notification",
    "allow-native-call-relay",
    "allow-attachment-save-begin",
    "allow-attachment-save-write",
    "allow-attachment-save-finish",
    "allow-attachment-save-abort",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging"
  ]
}
